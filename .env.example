# Copy to .env for local development

# Application runtime
NODE_ENV=development
LOG_LEVEL=debug

# ClickHouse connection (always localhost — local dev or SSH tunnel to server)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=arbinet
CLICKHOUSE_USER=arbinet
CLICKHOUSE_PASSWORD=***REMOVED***

# Data sync window
DATA_PERIOD_START=2025-01-01T00:00:00Z
DATA_PERIOD_END=

# App paths (local development)
DELISTINGS_DIR=src/markets/delistings
MIGRATIONS_DIR=src/db/migrations

# Funding sync tuning
FUNDING_RATE_SYNC_MODE=incremental
FUNDING_RATE_MAX_RETRIES=5
FUNDING_RATE_BACKOFF_BASE_MS=750
FUNDING_RATE_BACKOFF_MAX_MS=30000
FUNDING_RATE_PAGE_SIZE=100
FUNDING_RATE_SYMBOL_CONCURRENCY=5

# Quote download settings
DOWNLOAD_STALE_AGE_MS=7200000
DOWNLOAD_TEMP_DIR=./data/downloads
DOWNLOAD_MAX_RETRIES=5
DOWNLOAD_BACKOFF_BASE_MS=1000
DOWNLOAD_BACKOFF_MAX_MS=30000
DOWNLOAD_TIMEOUT_MS=300000
DOWNLOAD_SYMBOL_CONCURRENCY=3
DOWNLOAD_FILE_CONCURRENCY=8
VALIDATION_CONCURRENCY=4

# Alerting
SLACK_WEBHOOK_URL=
