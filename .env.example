# Copy this file to:
# - .env.dev  (used by dev infrastructure deployment)
# - .env.prod (used by prod infrastructure deployment)
# - .env      (optional local runtime/local DB only)

# Application runtime
NODE_ENV=development
LOG_LEVEL=debug

# ClickHouse connection (local dev)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=arbinet
CLICKHOUSE_USER=arbinet
CLICKHOUSE_PASSWORD=***REMOVED***
CLICKHOUSE_ALLOWED_CIDR=0.0.0.0/0

# Data sync window
DATA_PERIOD_START=2025-01-01T00:00:00Z
DATA_PERIOD_END=2026-02-01T00:00:00Z

# App paths (use these for .env.dev/.env.prod)
DELISTINGS_DIR=data/delistings
MIGRATIONS_DIR=data/migrations
# Local .env override (optional):
# DELISTINGS_DIR=src/markets/delistings
# MIGRATIONS_DIR=src/db/migrations

# Funding sync tuning
FUNDING_RATE_MAX_RETRIES=5
FUNDING_RATE_BACKOFF_BASE_MS=750
FUNDING_RATE_BACKOFF_MAX_MS=30000
FUNDING_RATE_PAGE_SIZE=100
FUNDING_RATE_SYMBOL_CONCURRENCY=5

# SST deployment
AWS_REGION=eu-central-1
CLICKHOUSE_INSTANCE_TYPE=t3.small
CLICKHOUSE_VOLUME_SIZE_GB=50
# EventBridge cron(minute hour day month dow year) UTC; 1 = at :01
MARKET_SYNC_SCHEDULE=cron(1 0/6 * * ? *)
FUNDING_RATES_SCHEDULE=cron(1 * * * ? *)
WORKER_LOG_LEVEL=info
SLACK_WEBHOOK_URL=REDACTED
