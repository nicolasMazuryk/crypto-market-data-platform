# .env.example — copy to .env and fill in real values
#
# WARNING: Never commit a .env file with real secrets to git.
#          Exchange API keys, Postgres passwords, and webhook URLs are secrets.
#          See CONFIG.md for the full secret-management guide.

# ── Application runtime ───────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL (execution engine persistence) ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arbinet
POSTGRES_USER=arbinet
POSTGRES_PASSWORD=change_me_in_dot_env
EXECUTION_POSTGRES_URL=postgresql://arbinet:<POSTGRES_PASSWORD>@localhost:5432/arbinet

# ── ClickHouse (market data + funding rates) ──────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=arbinet
CLICKHOUSE_USER=arbinet
CLICKHOUSE_PASSWORD=change_me_in_dot_env

# ── Application paths ─────────────────────────────────────────────────────────
DELISTINGS_DIR=data/delistings
MIGRATIONS_DIR=data/migrations

# ── Sync data window (markets and funding_rates) ──────────────────────────────
SYNC_DATA_PERIOD_START=2025-01-01T00:00:00Z
SYNC_DATA_PERIOD_END=

# ── Funding rate sync tuning ──────────────────────────────────────────────────
FUNDING_RATE_MAX_RETRIES=5
FUNDING_RATE_BACKOFF_BASE_MS=750
FUNDING_RATE_BACKOFF_MAX_MS=30000
FUNDING_RATE_PAGE_SIZE=100
FUNDING_RATE_SYMBOL_CONCURRENCY=3

# ── Funding download tasks ────────────────────────────────────────────────────
FUNDING_DOWNLOAD_TASKS_DATE_RANGE_START=2026-04-16
FUNDING_DOWNLOAD_TASKS_DATE_RANGE_END=2026-07-26
FUNDING_DOWNLOAD_TASKS_THRESHOLD=-0.003
FUNDING_DOWNLOAD_TASKS_DRY_RUN=false
FUNDING_DOWNLOAD_TASKS_EXCLUDED_EXCHANGES=mexc

# ── Quote download settings ───────────────────────────────────────────────────
# Stale temp task directories older than this are deleted at sync startup (default: 2 h)
DOWNLOAD_STALE_AGE_MS=7200000
DOWNLOAD_TEMP_DIR=./data/downloads
DOWNLOAD_MAX_RETRIES=5
DOWNLOAD_BACKOFF_BASE_MS=1000
DOWNLOAD_BACKOFF_MAX_MS=30000
DOWNLOAD_TIMEOUT_MS=300000
# How many download_tasks run concurrently
DOWNLOAD_SYMBOL_CONCURRENCY=3
# How many URLs are downloaded per task from DOWNLOAD_SYMBOL_CONCURRENCY workers
DOWNLOAD_FILE_CONCURRENCY=8
# Restrict a sync-quotes run to one exchange's pending tasks (empty = all exchanges)
QUOTE_SYNC_EXCHANGE=
# For validate-quotes script
VALIDATION_CONCURRENCY=4
QUOTES_VALIDATION_REPORT_PATH=./data/reports/quotes-validation/latest.json
# Comma-separated exchanges to validate (empty = all; skips cross-exchange checks when set)
QUOTES_VALIDATION_EXCHANGES=
AUDIT_DATE_RANGE_START=2026-04-16
AUDIT_DATE_RANGE_END=2026-07-26
AUDIT_REPORT_PATH=./data/reports/quotes-validation/coverage-audit.json

# ── Remote server ─────────────────────────────────────────────────────────────
REMOTE_SERVER_HOST=203.0.113.10
REMOTE_SSH_USER=nicolas
REMOTE_SSH_KEY=~/.ssh/nicolas

# ── Alerting ──────────────────────────────────────────────────────────────────
# Create a Slack app and generate an incoming webhook URL for your ops channel.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE

# ── Exchange API credentials (Mainnet) ────────────────────────────────────────
# Scope: trading + read — keys must have permissions to place/cancel orders and
# query balances. Use read-only keys for dry-run if your exchange supports it.
# Dry-run mode does not require any of these to be set.

BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

# OKX requires a passphrase set at API key creation time
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Bitget requires a passphrase set at API key creation time
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

GATEIO_API_KEY=
GATEIO_API_SECRET=

# KuCoin requires a passphrase set at API key creation time
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Sub-Account Provisioning
MASTER_BYBIT_API_KEY=
MASTER_BYBIT_API_SECRET=

MASTER_BITGET_API_KEY=
MASTER_BITGET_API_SECRET=
MASTER_BITGET_API_PASSPHRASE=

MASTER_KUCOIN_API_KEY=
MASTER_KUCOIN_API_SECRET=
MASTER_KUCOIN_API_PASSPHRASE=

MASTER_MEXC_API_KEY=
MASTER_MEXC_API_SECRET=
# ── Observability (Ansible group_vars read these from the controller env) ─────
GRAFANA_ADMIN_PASSWORD=change_me_in_dot_env
# caddy hash-password --plaintext "$GRAFANA_ADMIN_PASSWORD"
OBSERVABILITY_BASICAUTH_PASSWORD_HASH=
# e.g. 203-0-113-10.nip.io
OBSERVABILITY_PUBLIC_HOST=
OBSERVABILITY_ACME_EMAIL=you@example.com
