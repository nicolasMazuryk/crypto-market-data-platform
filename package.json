{
  "name": "datapipeline",
  "version": "1.0.0",
  "type": "module",
  "description": "A modern TypeScript project",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "sync:markets": "tsx src/scripts/sync-markets.ts",
    "sync:funding-rates": "tsx src/scripts/sync-funding-rates.ts",
    "validate:funding-rates": "tsx src/scripts/validate-funding-rates.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d clickhouse",
    "db:down": "docker compose --env-file .env -f docker/docker-compose.yml down clickhouse",
    "db:stop": "docker compose --env-file .env -f docker/docker-compose.yml stop",
    "db:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f clickhouse",
    "db:reset": "docker compose --env-file .env -f docker/docker-compose.yml down -v && docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "db:verify": "tsx src/scripts/verify-db.ts",
    "db:shell": "docker exec -it arbinet-clickhouse clickhouse-client",
    "deploy:dev": "bash infra/sst-with-env.sh dev deploy",
    "deploy:prod": "bash infra/sst-with-env.sh prod deploy",
    "deploy:migrate:dev": "bash infra/deploy-migrate.sh dev",
    "deploy:migrate:prod": "bash infra/deploy-migrate.sh prod",
    "deploy:migrate": "npm run deploy:migrate:prod",
    "deploy:remove:dev": "bash infra/deploy-remove.sh dev",
    "deploy:remove:prod": "bash infra/deploy-remove.sh prod",
    "logs:tail": "tail -f logs/combined.log",
    "logs:errors": "tail -f logs/error.log",
    "logs:clean": "rm -rf logs/*.log"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@pulumi/aws": "^7.19.0",
    "@pulumi/pulumi": "^3.219.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "sst": "^3.17.38",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@clickhouse/client": "^1.16.0",
    "ccxt": "^4.5.36",
    "dotenv": "^17.2.3",
    "pino": "^10.3.0"
  }
}
