# Application runtime
NODE_ENV=production
LOG_LEVEL=info

# ClickHouse connection
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT={{ clickhouse_http_port }}
CLICKHOUSE_NATIVE_PORT={{ clickhouse_native_port }}
CLICKHOUSE_DATABASE={{ clickhouse_database }}
CLICKHOUSE_USER={{ clickhouse_user }}
CLICKHOUSE_PASSWORD={{ clickhouse_password | default('') }}

# Sync data window
SYNC_DATA_PERIOD_START={{ sync_data_period_start }}
SYNC_DATA_PERIOD_END={{ sync_data_period_end }}

# Funding download tasks
FUNDING_DOWNLOAD_TASKS_DATE_RANGE_START={{ funding_download_tasks_date_range_start }}
FUNDING_DOWNLOAD_TASKS_DATE_RANGE_END={{ funding_download_tasks_date_range_end }}
FUNDING_DOWNLOAD_TASKS_THRESHOLD={{ funding_download_tasks_threshold }}
FUNDING_DOWNLOAD_TASKS_DRY_RUN={{ funding_download_tasks_dry_run }}
FUNDING_DOWNLOAD_TASKS_EXCLUDED_EXCHANGES={{ funding_download_tasks_excluded_exchanges }}

# App paths
DELISTINGS_DIR=/app/data/delistings
MIGRATIONS_DIR=/app/data/migrations

# Funding sync tuning
FUNDING_RATE_SYNC_MODE=incremental
FUNDING_RATE_MAX_RETRIES=5
FUNDING_RATE_BACKOFF_BASE_MS=750
FUNDING_RATE_BACKOFF_MAX_MS=30000
FUNDING_RATE_PAGE_SIZE=100
FUNDING_RATE_SYMBOL_CONCURRENCY=5

# Quote download settings
STALE_RECOVERY_MINUTES={{ quotes_sync_stale_recovery_minutes }}
DOWNLOAD_STALE_AGE_MS=7200000
DOWNLOAD_TEMP_DIR=/data/downloads
DOWNLOAD_MAX_RETRIES=5
DOWNLOAD_BACKOFF_BASE_MS=1000
DOWNLOAD_BACKOFF_MAX_MS=30000
DOWNLOAD_TIMEOUT_MS=300000
DOWNLOAD_SYMBOL_CONCURRENCY=3
DOWNLOAD_FILE_CONCURRENCY=8
VALIDATION_CONCURRENCY=16
QUOTES_VALIDATION_REPORT_PATH=/reports/quotes-validation/latest.json

# Alerting
SLACK_WEBHOOK_URL={{ slack_webhook_url }}
