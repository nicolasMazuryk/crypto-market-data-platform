#!/usr/bin/env bash
set -euo pipefail

UNIT="$1"
WEBHOOK_URL="{{ slack_webhook_url | default('') }}"

if [[ -z "$WEBHOOK_URL" ]]; then
  echo "No SLACK_WEBHOOK_URL configured, skipping notification"
  exit 0
fi

HOST=$(hostname)
LOGS=$(journalctl -u "$UNIT" --no-pager -n 20 --output=cat 2>/dev/null || echo "Failed to read logs")
PAYLOAD=$(HOST="$HOST" UNIT="$UNIT" LOGS="$LOGS" python3 - <<'PY'
import json
import os

text = f":x: *Worker failure on {os.environ['HOST']}*\nUnit: `{os.environ['UNIT']}`\n```{os.environ['LOGS']}```"
print(json.dumps({"text": text}))
PY
)

if ! curl -sf -X POST "$WEBHOOK_URL" \
  -H 'Content-Type: application/json' \
  -d "$PAYLOAD"; then
  echo "Failed to deliver Slack notification for ${UNIT}" >&2
fi
