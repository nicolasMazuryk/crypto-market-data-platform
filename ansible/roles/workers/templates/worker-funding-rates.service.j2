[Unit]
Description=Funding rates sync worker
After=docker.service
Requires=docker.service
OnFailure=worker-failure-notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker compose -f {{ docker_compose_file }} run --rm -e FUNDING_RATE_SYNC_MODE=incremental worker-funding-rates
TimeoutStartSec=1800
