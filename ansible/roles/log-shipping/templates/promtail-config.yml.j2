server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/promtail-positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  - job_name: containers
    static_configs:
      - targets:
          - localhost
        labels:
          job: container-logs
          env: production
          host: {{ inventory_hostname }}
          __path__: /var/lib/docker/containers/*/*-json.log
    pipeline_stages:
      # Parse the Docker JSON wrapper (log, stream, time, attrs fields)
      - json:
          expressions:
            log: log
            stream: stream
            time: time
            attrs: attrs
      - json:
          expressions:
            tag: tag
          source: attrs
      - regex:
          expression: '(?P<container_name>[^/]+)/(?P<image_name>[^:]+):?(?P<image_tag>.*)'
          source: tag
      - timestamp:
          format: RFC3339Nano
          source: time
      # Parse the inner pino JSON log line for structured field extraction
      - json:
          expressions:
            pino_level: level
            pino_module: module
            pino_component: component
            pino_exchange: exchange
            pino_strategy: strategy_id
          source: log
      - template:
          source: log_level
{% raw %}
          template: '{{ if eq .pino_level "10" }}trace{{ else if eq .pino_level "20" }}debug{{ else if eq .pino_level "30" }}info{{ else if eq .pino_level "40" }}warn{{ else if eq .pino_level "50" }}error{{ else if eq .pino_level "60" }}fatal{{ else }}unknown{{ end }}'
{% endraw %}
      - labels:
          stream:
          container_name:
          log_level:
          pino_module:
          pino_component:
          pino_exchange:
          pino_strategy:
      - output:
          source: log
