#!/usr/bin/env bash
set -euo pipefail

WEBHOOK_URL="{{ slack_webhook_url | default('') }}"
HOST=$(hostname)
ERRORS=()

# Check ClickHouse
if ! curl -sf http://localhost:{{ clickhouse_http_port }}/ping > /dev/null 2>&1; then
  ERRORS+=("ClickHouse is not responding")
fi

# Check Docker
if ! systemctl is-active --quiet docker; then
  ERRORS+=("Docker is not running")
fi

# Check disk usage
DISK_USAGE=$(df /data --output=pcent 2>/dev/null | tail -1 | tr -d ' %')
if [[ -n "$DISK_USAGE" ]] && (( DISK_USAGE > 80 )); then
  ERRORS+=("Disk usage at ${DISK_USAGE}%")
fi

# Alert only if a timer is enabled but not active (disabled timers are intentional)
for timer in worker-market-sync worker-funding-rates; do
  if systemctl is-enabled --quiet "${timer}.timer" 2>/dev/null; then
    if ! systemctl is-active --quiet "${timer}.timer"; then
      ERRORS+=("Timer ${timer}.timer is enabled but not active")
    fi
  fi
done

# ClickHouse memory overcommit check
# Detects when the internal tracker drifts above threshold and stays there,
# which causes OvercommitTracker to reject all queries even with plenty of actual free RAM.
MEMORY_STATE_FILE="/tmp/clickhouse-memory-alert.state"
MEMORY_THRESHOLD_PCT={{ clickhouse_memory_alert_threshold_pct | default(80) }}
MEMORY_ALERT_CONSECUTIVE={{ clickhouse_memory_alert_consecutive_checks | default(3) }}
MEMORY_COOLDOWN={{ clickhouse_memory_alert_cooldown_checks | default(10) }}

clickhouse_query() {
  curl -sf --get "http://localhost:{{ clickhouse_http_port }}/" \
    --user "{{ clickhouse_user }}:{{ clickhouse_password }}" \
    --data-urlencode "query=$1" \
    --data-urlencode "default_format=TabSeparated" 2>/dev/null | tr -d '[:space:]'
}

if curl -sf http://localhost:{{ clickhouse_http_port }}/ping > /dev/null 2>&1; then
  TRACKED=$(clickhouse_query "SELECT value FROM system.metrics WHERE metric='MemoryTracking' FORMAT TabSeparated")
  MAX_MEM=$(clickhouse_query "SELECT value FROM system.server_settings WHERE name='max_server_memory_usage' FORMAT TabSeparated")

  if [[ "$MAX_MEM" == "0" || -z "$MAX_MEM" ]]; then
    TOTAL_RAM=$(clickhouse_query "SELECT value FROM system.asynchronous_metrics WHERE metric='OSMemoryTotal' FORMAT TabSeparated")
    MAX_MEM=$(( ${TOTAL_RAM:-0} * 9 / 10 ))
  fi

  if [[ -n "$TRACKED" && -n "$MAX_MEM" && "$MAX_MEM" -gt 0 ]]; then
    MEM_PCT=$(( TRACKED * 100 / MAX_MEM ))
    CURRENT_COUNT=$(cat "$MEMORY_STATE_FILE" 2>/dev/null || echo "0")

    if (( MEM_PCT >= MEMORY_THRESHOLD_PCT )); then
      NEW_COUNT=$(( CURRENT_COUNT + 1 ))
      echo "$NEW_COUNT" > "$MEMORY_STATE_FILE"

      if (( NEW_COUNT == MEMORY_ALERT_CONSECUTIVE )) || \
         (( NEW_COUNT > MEMORY_ALERT_CONSECUTIVE && (NEW_COUNT - MEMORY_ALERT_CONSECUTIVE) % MEMORY_COOLDOWN == 0 )); then
        TRACKED_GIB=$(echo "scale=1; $TRACKED / 1073741824" | bc)
        MAX_GIB=$(echo "scale=1; $MAX_MEM / 1073741824" | bc)
        SUSTAINED_MIN=$(( (NEW_COUNT - 1) * 3 ))
        ERRORS+=("ClickHouse memory tracker at ${MEM_PCT}% (${TRACKED_GIB} GiB / ${MAX_GIB} GiB) — sustained ${SUSTAINED_MIN}+ min. SSH in and restart ClickHouse to fix.")
      fi
    else
      echo "0" > "$MEMORY_STATE_FILE"
    fi
  fi
fi

# Report
{% raw %}
if [[ ${#ERRORS[@]} -eq 0 ]]; then
{% endraw %}
  echo "All health checks passed"
  exit 0
fi

MSG=$(printf -- '- %s\n' "${ERRORS[@]}")
echo "Health check failures:"
echo "$MSG"

if [[ -z "$WEBHOOK_URL" ]]; then
  echo "No SLACK_WEBHOOK_URL configured, skipping notification"
  exit 1
fi

curl -sf -X POST "$WEBHOOK_URL" \
  -H 'Content-Type: application/json' \
  -d @- <<EOF
{
  "text": ":warning: *Health check failed on ${HOST}*\n${MSG}"
}
EOF

exit 1
