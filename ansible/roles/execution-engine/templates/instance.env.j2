# Per-instance secrets for {{ combo_entry.id }} — managed by fleet reconciler
# Root-owned 0400; injected via --env-file, never read directly by application code.
# Contains only the credentials for exchange: {{ combo_entry.exchange }}

{{ combo_entry.exchange | upper }}_API_KEY={{ combo_entry.api_key }}
{{ combo_entry.exchange | upper }}_API_SECRET={{ combo_entry.api_secret }}
{% if combo_entry.api_passphrase %}
{{ combo_entry.exchange | upper }}_API_PASSPHRASE={{ combo_entry.api_passphrase }}
{% endif %}

# Execution persistence
EXECUTION_POSTGRES_URL=postgresql://{{ postgres_user }}:{{ postgres_password | default('') }}@localhost:{{ postgres_port }}/{{ postgres_db }}
